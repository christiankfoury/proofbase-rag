# Local Docker/default development values. Do not commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_knowledge_agent

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DEFAULT_TOP_K=5
DEFAULT_DEMO_USER_ID=00000000-0000-0000-0000-000000002701
LOG_LEVEL=INFO
OBSERVABILITY_LOG_PATH=data/observability/request-logs.jsonl
AUDIT_LOG_PATH=data/audit/audit-events.jsonl
UPLOAD_STORAGE_DIR=data/uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

PROOFBASE_TELEMETRY_ENABLED=false
PROOFBASE_TELEMETRY_ENDPOINT=http://localhost:8000/v1/usage/llm-events
PROOFBASE_TELEMETRY_API_KEY=proofbase-local-placeholder-key-not-a-secret
PROOFBASE_TELEMETRY_TIMEOUT_SECONDS=2
PROOFBASE_TELEMETRY_REDACT_CONTENT=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
