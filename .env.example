# Local Docker/default development values. Do not commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_knowledge_agent

# Identity defaults are local-only. Production rejects local_demo and oidc_fixture.
APP_ENVIRONMENT=local
SECRET_PROVIDER_MODE=environment
SECRET_MOUNT_DIR=/run/secrets
AUTH_MODE=local_demo
OIDC_ISSUER=https://identity.local.proofbase.invalid
OIDC_AUDIENCE=proofbase-api
OIDC_LOCAL_SIGNING_SECRET=
OIDC_FUTURE_PROVIDER=microsoft_entra_id
SESSION_ABSOLUTE_MINUTES=480
SESSION_IDLE_MINUTES=30
DEFAULT_DEMO_TENANT_ID=00000000-0000-0000-0000-000000002801
DATABASE_ENFORCE_RLS=true
DATABASE_RUNTIME_ROLE=proofbase_runtime
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
MAX_REQUEST_BYTES=12000000
MAX_QUESTION_CHARS=4000
TENANT_DAILY_AI_BUDGET_USD=5.0
EXTERNAL_AI_MAX_RETRIES=1
FILE_QUARANTINE_DIR=data/quarantine
FILE_MAX_BYTES=10485760
FILE_MAX_PAGES=100
FILE_MAX_EXTRACTED_CHARS=2000000
FILE_MAX_EXPANSION_RATIO=200
FILE_PARSER_TIMEOUT_SECONDS=15
FILE_PARSER_MODE=subprocess
FILE_SCANNER_MODE=fixture_signature
FILE_QUARANTINE_RETENTION_DAYS=7
FILE_APPROVED_ORIGINAL_RETENTION_DAYS=30
FILE_ACCESS_SIGNING_SECRET=
FILE_ACCESS_SIGNING_SECRET_FILE=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REQUEST_ASSESSMENT_MODE=semantic_all_remaining
REQUEST_ASSESSMENT_MODEL=gpt-4.1-mini
REQUEST_ASSESSMENT_PROMPT_VERSION=v2
REQUEST_ASSESSMENT_TIMEOUT_SECONDS=8
EVIDENCE_ASSESSMENT_MODE=hybrid
EVIDENCE_ASSESSMENT_MODEL=gpt-4.1-mini
EVIDENCE_ASSESSMENT_PROMPT_VERSION=v2
EVIDENCE_ASSESSMENT_TIMEOUT_SECONDS=15
POST_GENERATION_VALIDATION_MODEL=gpt-4.1-mini
POST_GENERATION_VALIDATION_PROMPT_VERSION=v2
POST_GENERATION_VALIDATION_TIMEOUT_SECONDS=30

DEFAULT_TOP_K=5
DEFAULT_DEMO_USER_ID=00000000-0000-0000-0000-000000002701
LOG_LEVEL=INFO
OBSERVABILITY_LOG_PATH=data/observability/request-logs.jsonl
AUDIT_LOG_PATH=data/audit/audit-events.jsonl
OBSERVABILITY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
INCIDENT_EVIDENCE_HOLD=false
SECURITY_EVENT_SINK_MODE=local_jsonl
SECURITY_EVENT_LOG_PATH=data/security/security-events.jsonl
SECURITY_NOTIFICATION_LOG_PATH=data/security/local-notifications.jsonl
UPLOAD_STORAGE_DIR=data/uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

PROOFBASE_TELEMETRY_ENABLED=false
PROOFBASE_TELEMETRY_ENDPOINT=http://localhost:8000/v1/usage/llm-events
PROOFBASE_TELEMETRY_API_KEY=
PROOFBASE_TELEMETRY_API_KEY_FILE=
PROOFBASE_TELEMETRY_TIMEOUT_SECONDS=2
PROOFBASE_TELEMETRY_MAX_METADATA_BYTES=2048
PROOFBASE_TELEMETRY_REDACT_CONTENT=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
