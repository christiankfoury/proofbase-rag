  "protected_sealed_suites": [
    {
      "suite_path": "data/evaluation/independent-generalization/holdout-v1.json",
      "seal_path": "data/evaluation/independent-generalization/holdout-v1.sha256"
    },
    {
      "suite_path": "data/evaluation/independent-generalization/holdout-v2.json",
      "seal_path": "data/evaluation/independent-generalization/holdout-v2.sha256"
    },
    {
      "suite_path": "data/evaluation/independent-generalization/holdout-v3.json",
      "seal_path": "data/evaluation/independent-generalization/holdout-v3.sha256"
    },
    {
      "suite_path": "data/evaluation/defense/phase55-defense-holdout-v1.json",
      "seal_path": "data/evaluation/defense/phase55-defense-holdout-v1.sha256"
    }
  ],
  "sealed_suite_policy": "Existing protected suites may be hash-verified but never used as development data, selectively rerun, or tuned against. A future claim requires a newly authored suite under separate custody after runtime freeze."
