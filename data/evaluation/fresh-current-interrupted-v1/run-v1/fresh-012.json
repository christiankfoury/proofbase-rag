        "IT/Admin"
      ],
      "chunk_id": "761e8f7a-e3e7-4c09-9728-dcec7780327e",
      "content": "AI and Automation\n\nApproved AI tools may process Public and Internal data. Confidential or Restricted data requires an approved tool and a documented business purpose.",
      "department_id": "00000000-0000-0000-0000-000000002003",
      "document_id": "IT-003",
      "project_id": "00000000-0000-0000-0000-000000000019",
      "tenant_id": "00000000-0000-0000-0000-000000002801"
