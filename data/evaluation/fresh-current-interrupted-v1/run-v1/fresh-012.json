        "Sales Representative",
        "Manager",
        "HR Admin",
        "IT/Admin"
      ],
      "chunk_id": "e6e54af9-8787-4c13-b6fc-818ca5577795",
      "content": "Approved Software\n\nEmployees should use company-approved software for messaging, file storage, source control, project tracking, and customer collaboration. Unapproved software that stores company data must not be used without IT review.",
      "department_id": "00000000-0000-0000-0000-000000002003",
      "document_id": "IT-001",
      "project_id": "00000000-0000-0000-0000-000000000019",
      "tenant_id": "00000000-0000-0000-0000-000000002801"
