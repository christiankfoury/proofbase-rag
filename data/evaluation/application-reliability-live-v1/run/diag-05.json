        "IT/Admin"
      ],
      "chunk_id": "73cda377-3fd2-4907-b799-92db1cc31555",
      "content": "Not Covered\n\nThis policy does not provide legal advice, immigration advice, or guaranteed approval for international remote work.",
      "department_id": "00000000-0000-0000-0000-000000002001",
      "document_id": "HR-003",
      "document_title": "Remote and Hybrid Work Policy",
      "project_id": "00000000-0000-0000-0000-000000000019",
      "tenant_id": "00000000-0000-0000-0000-000000002801"
