      "chunk_id": "785237ea-4f16-43ca-9a6b-1edbf934793b",
      "content": "One-on-One Expectations\n\nManagers should hold one-on-one meetings with direct reports at least every two weeks. Notes should focus on priorities, blockers, feedback, and growth needs. Sensitive personal details should not be recorded unless required for an HR process.",
      "department_id": "00000000-0000-0000-0000-000000002006",
      "document_id": "MGR-001",
      "project_id": "00000000-0000-0000-0000-000000000019",
      "tenant_id": "00000000-0000-0000-0000-000000002801"
