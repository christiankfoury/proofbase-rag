      ],
      "chunk_id": "2e50cf74-e3fd-4313-9d14-e4003752b3ad",
      "content": "Discovery Questions\n\nSales Representatives should ask about workflow volume, approval bottlenecks, reporting delays, data quality pain points, integration needs, and executive visibility. Good discovery connects operational friction to measurable business outcomes.",
      "department_id": "00000000-0000-0000-0000-000000002005",
      "document_id": "SALES-001",
      "project_id": "00000000-0000-0000-0000-000000000019",
      "tenant_id": "00000000-0000-0000-0000-000000002801"
