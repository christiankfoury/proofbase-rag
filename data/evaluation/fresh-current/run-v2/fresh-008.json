      ],
      "chunk_id": "e638403c-0301-4b94-b636-04e2fdd6c813",
      "content": "Core Value Proposition\n\nNorthstar Analytics gives operations teams one place to monitor workflows, approvals, data quality issues, and executive KPIs. The strongest message is operational visibility with measurable process improvement.",
      "department_id": "00000000-0000-0000-0000-000000002005",
      "document_id": "SALES-002",
      "project_id": "00000000-0000-0000-0000-000000000019",
      "tenant_id": "00000000-0000-0000-0000-000000002801"
